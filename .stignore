// Git internals — never sync
.git
**/.git

// Git worktrees
.worktrees/
**/.worktrees/

// Python cache
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd

// Virtual environments
venv/
**/venv/
.venv/
**/.venv/

// Archived / legacy
archived-projects/

// OS
.DS_Store
Thumbs.db
desktop.ini

// Large binary / logs
*.log
database/*.db
database/legacy/*.db

// Secrets — NEVER sync to Windows
.secrets/
*.asc
*.pem
**/.gnupg/
**/rclone.conf
// .env variants: .env, .env.dev, .env.bak.*, .env.local, etc.
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
