# DQIII8 — Environment Configuration
# Copy this file to .env (repo root) and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────
# PROVIDER TIERS (cost-first: start cheap, escalate only when needed)
# ─────────────────────────────────────────────────────────────────────

# ── Tier C — Ollama (local, $0, no key needed) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Required models: qwen2.5-coder:7b (Tier C code tasks)
# Knowledge base (optional): bge-m3 — only needed with --with-knowledge

# ── Tier B — Groq (free, REQUIRED minimum) ────────────────────────────
GROQ_API_KEY=           # console.groq.com — free, llama-3.3-70b-versatile

# ── Tier B+ — NVIDIA NIM (free, 40 RPM, 1M context) ──────────────────
NVIDIA_API_KEY=         # integrate.api.nvidia.com/v1 — free API key

# ── Tier B++ — GitHub Models (free with GitHub account) ───────────────
GITHUB_TOKEN=           # Settings → Developer settings → Personal access tokens

# ── Tier A/S — Anthropic (paid, optional) ─────────────────────────────
# ANTHROPIC_API_KEY=    # console.anthropic.com — Claude Sonnet (A) + Opus (S)
# Claude Code OAuth also works (no key needed if using claude CLI)

# ── Optional: OpenRouter (alternative gateway) ────────────────────────
# OPENROUTER_API_KEY=   # openrouter.ai — access many models via one key

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL FEATURES
# ─────────────────────────────────────────────────────────────────────

# ── Telegram bot ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=   # @BotFather on Telegram
# TELEGRAM_CHAT_ID=     # Your Telegram chat ID (send /start to your bot)

# ── Additional integrations ───────────────────────────────────────────
# GEMINI_API_KEY=       # For /gemini-review workflow
# CONTACT_EMAIL=        # OpenAlex API polite pool (knowledge_harvester.py)

# ─────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE (VPS / MCP portability)
# ─────────────────────────────────────────────────────────────────────
# DQIII8_VPS_HOST=      # SSH target, e.g. root@your-vps-ip
# DQIII8_ROOT=/root/dqiii8          # VPS default; Windows: C:\DQIII8\dqiii8
# PYTHON=python3                    # VPS: python3 | Windows: python
